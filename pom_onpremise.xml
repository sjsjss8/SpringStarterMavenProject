<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  pom_onpremise.xml — 온프레미스 배포 패키지(ZIP) 생성 전용 POM
  ============================================================
  역할:
    메인 pom.xml로 JAR를 빌드한 뒤, 이 POM으로 고객사 납품용
    ZIP 패키지를 생성한다.

  사용법 (2단계):
    ① JAR 빌드     : mvn clean package -DskipTests
    ② ZIP 패키지   : mvn -f pom_onpremise.xml package

    또는 한 번에:
      mvn clean package -DskipTests && mvn -f pom_onpremise.xml package

  결과물:
    target/spring-starter-maven-1.0-release.zip

  ZIP 내부 구조:
    spring-starter-maven-1.0/
    ├── app.jar
    ├── INSTALL.md
    ├── config/application.yml   ← 고객이 DB 정보 입력
    ├── mapper/**/*.xml          ← MyBatis SQL (고객 편집 가능)
    └── bin/
        ├── install.sh / install.bat     ← 최초 자동 설치
        ├── start.sh   / start.bat       ← 시작
        ├── stop.sh    / stop.bat        ← 종료
        └── uninstall.sh / uninstall.bat ← 제거

  주의:
    이 POM은 <packaging>pom</packaging> 으로 선언되어 있어
    컴파일/테스트를 수행하지 않는다.
    반드시 mvn clean package (메인 pom.xml) 로 JAR를 먼저 빌드해야 한다.
  ============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      메인 pom.xml 과 동일한 좌표를 사용.
      assembly 디스크립터에서 ${project.artifactId}, ${project.version} 참조 시
      target/SpringStarterMavenProject-1.0.jar 를 자동으로 찾는다.
    -->
    <groupId>com.example</groupId>
    <artifactId>SpringStarterMavenProject</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>  <!-- 컴파일 없이 패키징만 수행 -->

    <name>SpringStarterMavenProject — On-Premise Package Builder</name>
    <description>
        온프레미스 고객사 납품용 ZIP 패키지를 생성하는 전용 POM.
        메인 pom.xml 로 JAR 빌드 후 이 파일로 ZIP 패키지를 생성한다.
    </description>

    <build>
        <plugins>

            <!--
              maven-assembly-plugin
              src/assembly/onpremise.xml 에 정의된 구조대로 ZIP 파일을 생성한다.

              결과 파일명 규칙: <finalName>-<assembly.id>.zip
                spring-starter-maven-1.0  +  -release  +  .zip
                = spring-starter-maven-1.0-release.zip
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <!-- 패키지 구조 정의 파일 -->
                    <descriptors>
                        <descriptor>src/assembly/onpremise.xml</descriptor>
                    </descriptors>
                    <!-- ZIP 파일 기본 이름 (버전 자동 반영) -->
                    <finalName>spring-starter-maven-${project.version}</finalName>
                    <!-- 메인 target/ 디렉터리에 출력 (기본값과 동일하나 명시) -->
                    <outputDirectory>${project.basedir}/target</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>make-onpremise-package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
