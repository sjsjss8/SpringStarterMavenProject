<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  pom.xml — Maven 프로젝트 설정 파일 (Project Object Model)
  ============================================================
  역할:
    Maven 빌드 도구가 읽는 핵심 설정 파일.
    "이 프로젝트는 어떤 라이브러리가 필요하고, 어떤 도구로 빌드하는가"를 정의.

  핵심 구성:
    1. parent      - Spring Boot가 제공하는 기본 설정 상속
    2. properties  - 버전 번호 등 공통 변수 선언
    3. dependencies - 외부 라이브러리 선언 (Maven이 자동으로 다운로드)
    4. build/plugins - 빌드 과정에서 실행할 도구 설정

  자주 쓰는 빌드 명령어:
    mvnw.cmd clean install              전체 빌드 + 테스트
    mvnw.cmd clean package -DskipTests  테스트 없이 JAR 파일만 생성
    mvnw.cmd test                       테스트만 실행
    mvnw.cmd spring-boot:run            로컬에서 바로 실행
    mvnw.cmd spotbugs:check             SpotBugs 정적 분석 실행
    mvnw.cmd org.owasp:dependency-check-maven:check  보안 취약점 검사
  ============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <!--
      부모 POM: Spring Boot가 제공하는 기본 설정을 상속받는다.
      이 선언 하나로:
        - 수백 개 라이브러리의 버전이 자동으로 호환 버전으로 맞춰짐 (BOM: Bill of Materials)
        - 자바 컴파일러 버전, UTF-8 인코딩, 기본 플러그인 설정이 적용됨
        - <dependency>에서 <version>을 생략해도 되는 이유가 여기에 있음
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
    </parent>

    <!--
      프로젝트 식별자 (Maven 좌표)
        groupId   : 조직/팀 단위 네임스페이스 (보통 도메인 역순, 예: com.회사명)
        artifactId: 프로젝트 이름 (JAR 파일명의 기반)
        version   : 프로젝트 버전 → 최종 결과물: app.jar (<finalName>app</finalName>으로 고정)
    -->
	<groupId>com.example</groupId>
	<artifactId>SpringStarterMavenProject</artifactId>
	<version>1.0</version>
	<name>SpringStarterMavenProject</name>
	<description>Demo project for Spring Boot</description>

    <!--
      공통 버전 프로퍼티
      아래 ${변수명} 형태로 여러 곳에서 참조.
      버전 업그레이드 시 이곳 한 줄만 수정하면 된다.

      ※ Spring Boot BOM이 관리하는 라이브러리(web, test 등)는 여기 선언 불필요.
        BOM이 모르는 서드파티 라이브러리만 여기에 명시.
    -->
	<properties>
		<java.version>17</java.version>                     <!-- 컴파일 타겟 JDK 버전 -->
		<mapstruct.version>1.5.5.Final</mapstruct.version>  <!-- DTO ↔ Entity 변환 라이브러리 -->
		<springdoc.version>2.7.0</springdoc.version>        <!-- Swagger UI 자동 생성 (Spring Boot 3.4.x 호환은 2.6.0+ 필요) -->
	</properties>

    <!--
      ════════════════════════════════════════════════════════
      의존성(Dependencies) 선언
      여기에 선언된 라이브러리는 Maven이 Maven Central에서 자동으로 다운로드.
      scope 미지정 = compile (기본값): 컴파일 + 런타임 + 테스트 모두 포함.
      ════════════════════════════════════════════════════════
    -->
    <dependencies>

        <!-- ── 웹 계층 ─────────────────────────────────────────────────────── -->

        <!--
          spring-boot-starter-web
          Spring MVC 프레임워크 + 내장 Tomcat 서버 포함 패키지.
          이 하나로: 내장 웹서버 + HTTP 요청 라우팅 + JSON 직렬화(@ResponseBody) 모두 가능.
          @RestController, @GetMapping, @PostMapping 등이 이 의존성에서 온다.

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - 내장 Tomcat이 기본 포트 8080에서 자동 기동 (web.xml, server.xml 불필요)
            - Jackson 자동 등록 → 객체 ↔ JSON 변환 (@RequestBody / @ResponseBody)
            - DispatcherServlet, MVC 메시지 컨버터, 정적 리소스 핸들러 자동 등록
            - 예외 발생 시 기본 ErrorPage(/error) 자동 매핑

          ── 간단 커스터마이징 ─────────────────────────────────────────────
            server.port: 8081                       # application.yml에서 한 줄로 포트 변경
            spring.mvc.servlet.path: /api           # 모든 컨트롤러 prefix 추가
            spring.jackson.date-format: yyyy-MM-dd  # 날짜 직렬화 포맷
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          spring-boot-starter-thymeleaf
          서버사이드 HTML 렌더링 템플릿 엔진.
          컨트롤러에서 ModelAndView 또는 String(뷰 이름)을 반환하면
          src/main/resources/templates/*.html 파일을 찾아 HTML로 렌더링.
          (React/Vue 같은 SPA가 아닌, 서버가 HTML을 직접 생성하는 전통적인 MVC 방식)

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - ViewResolver가 자동 등록되어 컨트롤러 반환값(String) → templates/{값}.html 매핑
            - 기본 prefix: classpath:/templates/  /  기본 suffix: .html
            - HTML 이스케이프, UTF-8 인코딩, Spring Security 다이얼렉트(있을 때) 자동 적용
            - 운영 환경에서는 캐시 자동 활성화 (성능 ↑)

          ── 간단 커스터마이징 ─────────────────────────────────────────────
            spring.thymeleaf.cache: false           # 로컬에서 템플릿 즉시 반영 (이미 적용)
            spring.thymeleaf.prefix: classpath:/views/   # 템플릿 위치 변경
        -->
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-thymeleaf</artifactId>
	    </dependency>

        <!-- ── 데이터베이스 ────────────────────────────────────────────────── -->

        <!--
          mybatis-spring-boot-starter
          MyBatis ORM 프레임워크 + Spring Boot 자동설정 패키지.
          JPA(Hibernate)와 달리 SQL을 개발자가 직접 작성.
            - @Mapper 인터페이스: 메서드 시그니처 선언
            - XML 매퍼 (resources/static/mybatis/mapper/**/*.xml): 실제 SQL 작성
          조인이 복잡하거나 SQL 최적화가 중요한 프로젝트에 적합.
          version: Spring Boot BOM에 없어서 직접 명시.

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - SqlSessionFactory, SqlSessionTemplate 자동 등록 (DataSource 만 있으면 OK)
            - @Mapper 어노테이션이 붙은 인터페이스를 classpath 에서 자동 스캔
              → @MapperScan 같은 별도 어노테이션 불필요
            - 인터페이스의 프록시 빈을 만들어 @Autowired 로 바로 주입 가능

          ── 간단 커스터마이징 (이미 application.yml에 적용됨) ─────────────
            mybatis.mapper-locations: classpath:/static/mybatis/mapper/**/*.xml   # XML 위치
            mybatis.type-aliases-package: com.example.demo                       # 별칭 패키지
            mybatis.configuration.map-underscore-to-camel-case: true             # snake_case → camelCase
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!--
          spring-boot-starter-data-jpa
          Spring Data JPA + Hibernate(JPA 구현체) 포함 패키지.

          JPA + MyBatis 공존 전략:
            - 기본 CRUD / 단순 조회        → JpaRepository (인터페이스만 선언, 구현 자동 생성)
            - 복잡한 동적 쿼리 / 통계/리포트 → MyBatis (XML에 SQL 직접 작성)

          한 트랜잭션 안에서 두 방식을 함께 사용해도 같은 DataSource를 공유하기 때문에
          데이터 정합성에 문제가 없다 (둘 다 Spring 트랜잭션 매니저 위에서 동작).

          엔티티는 @Entity + MyBatis @Alias 를 동시에 가져 양쪽에서 모두 사용 가능.

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - DataSource(HikariCP)와 EntityManagerFactory 자동 구성
            - JpaTransactionManager + @Transactional 지원 자동 활성화
            - @Entity 클래스를 main 패키지 하위에서 자동 스캔
            - JpaRepository 를 상속한 인터페이스의 구현체 빈을 런타임에 자동 생성
              → save(), findById(), findAll(), delete() 등을 코드 한 줄 없이 사용
            - 메서드 이름 규칙(findByEmail, countByStatus 등)으로 쿼리 자동 생성

          ── 간단 커스터마이징 (application.yml 한두 줄) ───────────────────
            spring.jpa.hibernate.ddl-auto: validate          # 운영 표준 (자동 변경 X)
            spring.jpa.show-sql: true                        # 실행 SQL 콘솔 출력
            spring.jpa.properties.hibernate.format_sql: true # SQL 포맷팅
            spring.jpa.open-in-view: false                   # OSIV 끄기 (N+1 사고 예방)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          mariadb-java-client
          MariaDB에 연결하기 위한 JDBC 드라이버.
          scope=runtime: 소스코드에서 직접 import하지 않고 Spring이 내부적으로 사용.
            컴파일 시에는 불필요하지만 실행 시에는 반드시 있어야 함.
          버전은 Spring Boot BOM이 관리 → <version> 생략.

          ── 자동설정 ────────────────────────────────────────────────────────
            - classpath 에 JDBC 드라이버가 존재하면 Spring Boot 가 자동 감지
              → DataSource 빈을 HikariCP 커넥션 풀로 자동 생성
            - spring.datasource.url 의 jdbc:mariadb:// 접두사로 드라이버 클래스 자동 추론
              (driver-class-name 명시 불필요. 명시해도 무해)
        -->
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<scope>runtime</scope>
		</dependency>

        <!-- ── 유틸리티 ───────────────────────────────────────────────────── -->

        <!--
          Lombok
          반복적인 보일러플레이트 코드를 애노테이션으로 자동 생성.
          예: @Getter → getXxx() 자동 생성, @Builder → 빌더 패턴 코드 자동 생성.
          컴파일 시에만 사용되고 최종 JAR에는 포함되지 않음(아래 spring-boot-maven-plugin에서 exclude).
          optional=true: 이 프로젝트를 라이브러리로 의존하는 다른 프로젝트에는 Lombok이 전파되지 않음.
          ※ 실제 코드 생성 처리기는 아래 maven-compiler-plugin의 annotationProcessorPaths에서 설정.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          MapStruct (런타임 라이브러리)
          DTO ↔ Entity 간 객체 변환 코드를 컴파일 타임에 자동 생성.
          개발자는 인터페이스(Mapper)만 선언하면 구현체가 빌드 시 자동으로 만들어짐.
          수동으로 obj.setName(dto.getName()) 을 반복하지 않아도 됨.
          ※ 코드 생성 도구(mapstruct-processor)는 아래 annotationProcessorPaths에서 관리.
        -->
	    <dependency>
	        <groupId>org.mapstruct</groupId>
	        <artifactId>mapstruct</artifactId>
	        <version>${mapstruct.version}</version>
	    </dependency>
        <!-- mapstruct-processor 는 annotationProcessorPaths 로 이동 (아래 maven-compiler-plugin 참고) -->

        <!-- ── API 문서화 ──────────────────────────────────────────────────── -->

        <!--
          springdoc-openapi-starter-webmvc-ui
          컨트롤러 코드를 읽어 Swagger UI(OpenAPI 3.0) 문서를 자동 생성.
          별도 문서 작성 없이 API 목록, 요청/응답 스펙, 직접 테스트 UI를 제공.
          접속 URL: http://localhost:8081/swagger-ui.html (application.yml에서 경로 설정)
          version: Spring Boot BOM에 없어서 직접 명시.

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - @RestController 가 붙은 모든 클래스를 스캔해 OpenAPI 스펙 자동 생성
            - /swagger-ui.html (UI) + /v3/api-docs (JSON 스펙) 엔드포인트 자동 노출
            - @Operation, @Parameter, @Schema 등의 어노테이션을 인식해 설명 보강

          ── 간단 커스터마이징 (이미 application.yml에 적용됨) ─────────────
            springdoc.swagger-ui.path: /swagger-ui.html      # UI 진입 URL
            springdoc.api-docs.path: /api-docs               # JSON 스펙 URL
            springdoc.swagger-ui.operations-sorter: alpha    # API 알파벳 정렬
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── 모니터링 ───────────────────────────────────────────────────── -->

        <!--
          spring-boot-starter-actuator
          운영 모니터링용 HTTP 엔드포인트를 자동으로 제공.
          주요 엔드포인트:
            /actuator/health            앱 + DB 연결 상태 확인 (Kubernetes probe, Docker healthcheck)
            /actuator/health/readiness  트래픽 수신 준비 여부 (K8s readinessProbe 전용)
            /actuator/health/liveness   앱 자체 생존 여부 (K8s livenessProbe 전용)
            /actuator/info              앱 버전, 빌드 시간 등 메타정보
            /actuator/metrics           Prometheus 연동용 메트릭 데이터
          노출 범위는 application-prod.yml에서 제한 (prod에서는 민감 정보 보호).

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - 의존성만 추가하면 /actuator/health 가 즉시 활성화
            - DataSource, Redis 등 등록된 컴포넌트의 상태를 health 에 자동 통합
              → DB 다운 시 health 가 자동으로 DOWN 응답 (K8s probe 가 자동 인식)
            - Micrometer 가 JVM/HTTP 메트릭을 자동 수집 → /actuator/metrics 에 노출
            - 기본 노출 엔드포인트: health, info 만 (보안 기본값)

          ── 간단 커스터마이징 (이미 application-prod.yml에 적용됨) ────────
            management.endpoints.web.exposure.include: health,info,metrics
            management.endpoint.health.show-details: when-authorized
            management.endpoint.health.probes.enabled: true   # K8s readiness/liveness 활성화
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── 테스트 ──────────────────────────────────────────────────────── -->

        <!--
          spring-boot-starter-test
          테스트 코드 작성에 필요한 라이브러리 모음.
          scope=test: 테스트 컴파일/실행에만 사용. 최종 JAR에는 포함되지 않음.
          포함 라이브러리: JUnit 5(테스트 프레임워크), Mockito(모킹), AssertJ(검증),
                          Spring MockMvc(컨트롤러 테스트), Spring Boot Test(통합 테스트)

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - @SpringBootTest        : 전체 컨텍스트 로딩 통합 테스트
            - @DataJpaTest           : JPA 슬라이스 테스트 (DataSource + Repository 만 로딩)
            - @WebMvcTest            : 컨트롤러 슬라이스 테스트 (서비스 mock 자동 권장)
            - @MockBean / @SpyBean   : 컨텍스트 안의 빈을 Mockito 로 자동 대체
            - MockMvc                : 실제 서버 띄우지 않고 HTTP 요청/응답 시뮬레이션
            - TestRestTemplate       : @SpringBootTest(webEnvironment=RANDOM_PORT) 와 함께 자동 주입

          ── 간단 사용 패턴 ────────────────────────────────────────────────
            @SpringBootTest @ActiveProfiles("test")          // → H2 인메모리 DB 자동 사용
            class MemberApplicationTests { ... }
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          H2 인메모리 데이터베이스
          테스트 전용 경량 DB. 애플리케이션 시작 시 메모리에 생성, 종료 시 사라짐.
          scope=test: 테스트 코드에서만 사용. 최종 JAR에 포함되지 않음.
          사용 이유: Jenkins CI 서버에 MariaDB가 없어도 Spring 컨텍스트 로딩 테스트 가능.
          application-test.yml에서 MODE=MariaDB로 MariaDB SQL 문법을 흉내냄.

          ── 자동설정 ────────────────────────────────────────────────────────
            - classpath에 H2 가 있고 명시적 DataSource 설정이 없으면
              Spring Boot 가 자동으로 jdbc:h2:mem:testdb URL 의 DataSource 생성
            - JPA 와 함께 사용 시 spring.jpa.hibernate.ddl-auto: create-drop 가 기본값
              → 매 테스트마다 스키마 재생성 (테스트 격리 자동 보장)
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ── 개발 도구 ───────────────────────────────────────────────────── -->

        <!--
          spring-boot-devtools
          개발 생산성 향상 도구. 운영 환경에서는 자동으로 비활성화됨.
          scope=runtime: 런타임에만 동작 (컴파일에는 관여 없음).
          optional=true: 다른 프로젝트에 전파 안 됨.
          주요 기능:
            - 자동 재시작: 클래스 파일 변경 감지 시 서버 재시작 (전체 재기동보다 빠름)
            - LiveReload : 정적 리소스/템플릿 변경 시 브라우저 자동 새로고침 (포트 35729)
            - 캐시 비활성화: Thymeleaf 템플릿 캐시 자동 OFF (application-local.yml과 중복이지만 안전망)

          ── 자동설정 (별도 설정 없이 즉시 동작) ────────────────────────────
            - 의존성만 추가하면 IDE 가 컴파일한 .class 변경을 감지해 컨텍스트 자동 재시작
            - 운영 JAR (java -jar) 실행 시 devtools 는 자동 비활성화 (안전)
            - LiveReload 서버가 포트 35729 에서 자동 기동
              → 브라우저에 LiveReload 확장 설치하면 코드 저장만으로 새로고침

          ── 간단 커스터마이징 (필요 시) ───────────────────────────────────
            spring.devtools.restart.enabled: false   # 자동 재시작 끄기
            spring.devtools.livereload.enabled: false  # LiveReload 끄기
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <!--
      ════════════════════════════════════════════════════════
      빌드 플러그인 설정
      mvn 명령 실행 시 이 플러그인들이 순서대로 동작.
      ════════════════════════════════════════════════════════
    -->
    <build>
        <!-- JAR 파일명을 버전 없이 고정 → 배포 스크립트·Dockerfile에서 항상 app.jar 참조 가능 -->
        <finalName>app</finalName>

        <plugins>

            <!--
              ── maven-compiler-plugin: 자바 소스코드 컴파일 설정 ────────────
              annotationProcessorPaths: 애노테이션 프로세서를 명시적 순서로 실행.

              왜 순서가 중요한가?
                1. Lombok이 먼저 실행 → @Getter/@Setter/@Builder 등 메서드를 .class에 생성
                2. MapStruct가 이어서 실행 → Lombok이 만든 메서드를 참조해 Mapper 구현체 생성

              이 설정 없이 <dependencies>에만 선언하면 실행 순서가 보장되지 않아
              "MapStruct가 Lombok 생성 메서드를 찾지 못함" 컴파일 오류 발생 가능.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- 1순위: Lombok이 먼저 @Getter, @Builder 등을 생성 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>  <!-- Spring Boot BOM이 관리하는 버전 참조 -->
                        </path>
                        <!-- 2순위: MapStruct가 Lombok 생성 결과를 참조해 Mapper 구현체 생성 -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              ── spring-boot-maven-plugin: 실행 가능한 Fat JAR 생성 ──────────
              일반 mvn package는 자신의 코드만 담은 얇은 JAR를 만들지만,
              이 플러그인은 모든 의존성(Tomcat 포함)을 하나의 JAR에 묶어줌.
              결과: java -jar app.jar 한 줄로 서버 없이 바로 실행 가능.

              excludes: Lombok은 컴파일 시에만 필요하고 런타임에는 필요 없음.
                최종 JAR에서 제거해 파일 크기를 줄이고 불필요한 클래스 포함을 방지.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              ── frontend-maven-plugin: Vue 3 SPA 자동 빌드 ─────────────────
              mvn package 실행 시 src/main/frontend/ 의 Vue 프로젝트를 자동으로 빌드.

              동작 흐름:
                1. Node.js + npm 을 자동 다운로드 (workingDirectory 안에 격리 — 시스템 설치 불필요)
                2. npm install (의존성 다운로드, package-lock.json 기준)
                3. npm run build (Vite 가 src/main/resources/static/spa/ 로 출력)
                4. Spring Boot 가 빌드된 정적 리소스를 JAR 에 포함 → 단일 JAR 로 배포 완성

              build 페이즈에 묶이므로 mvn clean install / mvn package 한 번이면 SPA 까지 다 빌드됨.
              개발 중 SPA 만 빨리 돌리고 싶을 때는 src/main/frontend 에서 npm run dev 사용.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>src/main/frontend</workingDirectory>
                    <installDirectory>target</installDirectory>  <!-- Node 다운로드 위치 (target/node, target/node_modules) -->
                </configuration>
                <executions>
                    <!-- 1. Node + npm 다운로드 (없을 때만, 캐시됨) -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v20.11.1</nodeVersion>
                            <npmVersion>10.2.4</npmVersion>
                        </configuration>
                    </execution>
                    <!-- 2. npm install (의존성 설치) -->
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <!-- 3. npm run build (Vite 빌드 → static/spa) -->
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              ── OWASP Dependency Check: 라이브러리 보안 취약점(CVE) 검사 ────
              사용 중인 모든 의존성을 NVD(미국 국가 취약점 데이터베이스)와 비교.
              알려진 보안 취약점이 있는 버전의 라이브러리를 사용하면 경고/빌드 실패.

              실행: mvnw.cmd org.owasp:dependency-check-maven:check
              결과: target/dependency-check-report.html (브라우저에서 열어서 확인)

              failBuildOnCVSS=7: CVSS 점수 7.0 이상(High 등급) 취약점 발견 시 빌드 실패.
                CVSS 점수: 0~3.9 낮음, 4~6.9 보통, 7~8.9 높음, 9~10 심각
              suppressionFile: 검토 후 오탐으로 확인된 항목을 예외 처리하는 XML 파일.
              formats: 리포트를 HTML(사람이 읽는 용)과 JSON(CI 도구 파싱용) 두 형식으로 저장.
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>9.0.9</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFile>config/owasp-suppressions.xml</suppressionFile>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
            </plugin>

            <!--
              ── SpotBugs + FindSecBugs: 소스코드 정적 보안 분석 ─────────────
              컴파일된 바이트코드(.class 파일)를 분석해 버그 패턴과 보안 취약점을 탐지.
              실제 실행 없이 코드를 분석하기 때문에 "정적(Static) 분석"이라 부름.

              실행: mvnw.cmd spotbugs:check (텍스트 결과)
                    mvnw.cmd spotbugs:gui   (GUI 뷰어 실행)

              FindSecBugs 플러그인: SpotBugs에 보안 탐지 규칙 추가.
                탐지 항목 예시: SQL Injection, XSS, 경로 조작, 민감 정보 하드코딩 등.
              excludeFilterFile: 오탐(False Positive)으로 확인된 규칙을 제외하는 XML 파일.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.3.0</version>
                <configuration>
                    <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.13.0</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>

            <!--
              ── Checkstyle: 코드 스타일(형식) 검사 ───────────────────────────
              코드의 기능이 아닌 "형식(들여쓰기, 줄 길이, 네이밍 규칙 등)"을 검사.
              팀 내 코드 스타일을 통일해 가독성을 높이는 도구.

              실행: mvnw.cmd checkstyle:check

              configLocation=google_checks.xml: 플러그인에 내장된 Google Java Style Guide 규칙 사용.
                (프로젝트 루트에 checkstyle.xml을 두면 커스텀 규칙 적용 가능)
              failsOnError=false: 스타일 위반이 있어도 빌드를 실패시키지 않음 (경고만 출력).
                true로 바꾸면 스타일 위반 시 빌드 실패 → 엄격한 팀 프로젝트에서 사용.
              consoleOutput=true: 위반 항목을 콘솔에 출력해 즉시 확인 가능.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <failsOnError>false</failsOnError>
                    <consoleOutput>true</consoleOutput>
                </configuration>
            </plugin>

            <!--
              ── maven-surefire-plugin: 단위 테스트 실행 ──────────────────────────
              대상 파일: *Test.java, *Tests.java, *TestCase.java
              skipUnitTests=true 시 단위 테스트만 건너뜀 (통합 테스트는 영향 없음)
              실행: mvnw.cmd test
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${skipUnitTests}</skip>
                </configuration>
            </plugin>

            <!--
              ── maven-failsafe-plugin: 통합 테스트 실행 ──────────────────────────
              대상 파일: *IT.java, *ITCase.java, *IntegrationTest.java
              단위 테스트(surefire)와 별도로 실행되며 서버 기동 후 테스트에 적합
              실행: mvnw.cmd verify -DskipUnitTests
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!--
      ════════════════════════════════════════════════════════
      프로파일 (Profiles)
      ════════════════════════════════════════════════════════
    -->
    <profiles>

        <!--
          ── onpremise 프로파일: 고객사 납품용 ZIP 패키지 생성 ──────────────
          활성화 방법:
            mvn clean package -Ponpremise
          IntelliJ: Maven 패널(우측) → Profiles → onpremise 체크 → package 실행

          결과물:
            target/SpringStarterMavenProject-1.0.jar        (JAR)
            target/spring-starter-maven-1.0-release.zip     (ZIP 패키지)

          ZIP 내부 구조:
            spring-starter-maven-1.0/
            ├── app.jar
            ├── INSTALL.md
            ├── config/application.yml   ← 고객이 DB 정보 입력
            ├── mapper/**/*.xml          ← MyBatis SQL (고객 편집 가능)
            └── bin/  install/start/stop/uninstall .sh .bat
        -->
        <profile>
            <id>onpremise</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/onpremise.xml</descriptor>
                            </descriptors>
                            <finalName>spring-starter-maven-${project.version}</finalName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-onpremise-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
