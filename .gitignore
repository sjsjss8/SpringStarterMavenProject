# ============================================================
# .gitignore — Git 추적 제외 파일 목록
# ============================================================
# 역할:
#   Git이 버전 관리하지 말아야 할 파일/디렉터리를 지정.
#   여기에 선언된 파일은 "git add ." 을 해도 추가되지 않음.
#
# 제외하는 주요 이유:
#   1. 보안: 비밀번호, API 키가 담긴 파일 (.env)
#   2. 용량: 빌드 결과물, 로그 파일 (target/, *.log)
#   3. 개인 설정: IDE 설정 파일 (.idea/, .vscode/)
#              → 팀원마다 다른 IDE를 쓰므로 공유할 필요 없음
#
# 패턴 문법:
#   *        : 임의의 문자열 (예: *.log = 모든 .log 파일)
#   **       : 하위 모든 디렉터리 포함
#   /        : 앞에 붙이면 루트 기준, 뒤에 붙이면 디렉터리
#   !        : 앞의 규칙 예외 처리 (예: !.env.example = .env.example은 추적)
# ============================================================

# ── Maven 빌드 결과물 ────────────────────────────────────────────────────────
HELP.md            # mvn spring-boot:run 시 자동 생성되는 도움말 파일
target/            # 컴파일된 클래스, 생성된 JAR 파일 등 빌드 산출물 전체
                   # "mvnw clean" 으로 삭제되는 디렉터리

# Maven Wrapper 파일은 제외하되, JAR 파일은 추적 (빌드 없이 Maven 자동 다운로드에 필요)
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/   # 소스 디렉터리 하위의 target은 제외 대상이 아님
!**/src/test/**/target/


# ── IDE 설정 파일 ────────────────────────────────────────────────────────────

### Spring Tool Suite (STS) ###
.apt_generated     # 애노테이션 프로세서 생성 파일
.classpath         # 프로젝트 클래스패스 설정 (STS 내부용)
.factorypath       # 애노테이션 프로세서 경로 설정
.project           # Eclipse/STS 프로젝트 메타데이터
.settings          # Eclipse 프로젝트 설정 디렉터리
.springBeans       # Spring 빈 설정 캐시
.sts4-cache        # STS 4 캐시 디렉터리

### IntelliJ IDEA ###
.idea              # IntelliJ 프로젝트 설정 디렉터리 (코드 스타일, 실행 설정 등)
*.iws              # IntelliJ 워크스페이스 파일
*.iml              # IntelliJ 모듈 설정 파일
*.ipr              # IntelliJ 프로젝트 파일

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/           # VS Code 에디터 설정 디렉터리 (extensions.json 등)


# ── 로그 파일 ────────────────────────────────────────────────────────────────
*.log              # 모든 로그 파일 (application.log, error.log 등)
logs/              # 로그 디렉터리


# ── 환경변수 / 비밀 정보 ──────────────────────────────────────────────────────
.env               # 로컬 환경변수 파일. DB 비밀번호 등 민감 정보 포함 → 절대 커밋 금지
!.env.example      # 하지만 템플릿 파일(.env.example)은 추적. 팀원이 참고용으로 사용


# ── Spring Boot application 설정 파일 ────────────────────────────────────────
# 모든 yml/properties 파일은 환경변수 참조만 사용 (민감 정보 직접 작성 금지)
# 실제 credentials 는 .env (로컬) 또는 Jenkins Credentials / K8s Secret (서버) 로 주입


# ── OS가 자동 생성하는 파일 ──────────────────────────────────────────────────
.DS_Store          # macOS: 디렉터리 메타데이터 (정렬 순서, 아이콘 위치 등)
.DS_Store?         # .DS_Store 변형
._*                # macOS: 리소스 포크 파일
.Spotlight-V100    # macOS: Spotlight 인덱스 파일
.Trashes           # macOS: 휴지통 정보
ehthumbs.db        # Windows: 썸네일 캐시 (Windows XP)
Thumbs.db          # Windows: 썸네일 캐시
