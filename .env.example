# ============================================================
# .env.example — 환경변수 템플릿 (Git 추적 O)
# ============================================================
# 역할:
#   .env 파일을 만들 때 참고하는 템플릿.
#   실제 값 대신 플레이스홀더가 들어있어 Git에 커밋해도 안전.
#   팀원이 처음 프로젝트를 셋업할 때 이 파일을 복사해서 .env를 만듦.
#
# 사용 방법:
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows CMD)
#   .env 파일을 열어 your_xxx_here 부분을 실제 값으로 교체
#
# .env vs .env.example:
#   .env         실제 비밀번호 포함 → Git 제외 (.gitignore에 등록됨)
#   .env.example 플레이스홀더만 포함 → Git 추적 (팀 공유용 템플릿)
#
# 이 파일을 읽는 곳:
#   - docker-compose.yml / docker-compose.prod.yml (docker-compose up 시 자동 로드)
#   - IDE Run Configuration에서 EnvFile 플러그인으로 로드
#   - Jenkinsfile: withCredentials로 Jenkins Credentials에서 별도 주입
# ============================================================

# ── Application ──────────────────────────────────────────────────────────────
TAG=latest          # Docker 이미지 태그 (docker-compose image: .../app:${TAG})
                    # Jenkins 배포 시 빌드 번호로 override됨 (예: build-42)

# ── Database ─────────────────────────────────────────────────────────────────
# DB_HOST 값은 어떻게 띄우느냐에 따라 다름:
#   • IDE 에서 직접 실행 (application-local.yml)        → localhost
#   • docker-compose up (외부 mariadb 컨테이너 사용)    → host.docker.internal  ※ 기본값
#   • docker-compose -f docker-compose.full.yml up      → mariadb (compose 서비스명)
#   • 기존 컨테이너 mariadb 와 같은 네트워크 합류 시      → mariadb (또는 그 컨테이너 이름)
DB_HOST=host.docker.internal
DB_PORT=3306        # MariaDB 기본 포트. 로컬에서 다른 포트 쓰면 변경 (예: 50002)
DB_NAME=SJSJSS      # 데이터베이스(스키마) 이름

# 기존 mariadb 컨테이너가 별도의 도커 네트워크에 있다면, 그 네트워크 이름:
# (docker-compose.yml 의 networks.app-network.external 블록 활성화 후 사용)
# COMPOSE_NETWORK=shared-mariadb-net

DB_ROOT_PASSWORD=your_root_password  # MariaDB root 계정 비밀번호
                                      # root는 모든 권한을 가지므로 앱 접속 계정과 반드시 분리

DB_USERNAME=your_db_user     # 앱이 DB 접속에 사용하는 계정 (root 사용 비권장)
                              # 최소 권한 원칙: SELECT, INSERT, UPDATE, DELETE 권한만 부여
DB_PASSWORD=your_db_password  # 위 계정의 비밀번호
